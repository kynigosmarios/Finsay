rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function householdDoc(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId));
    }

    function householdExists(householdId) {
      return exists(/databases/$(database)/documents/households/$(householdId));
    }

    function isHouseholdMemberData(data) {
      return data.ownerId == request.auth.uid ||
        request.auth.uid in data.get('memberUids', []);
    }

    function canManageMembersAndCategoriesData(data) {
      return data.ownerId == request.auth.uid || (
        request.auth.uid in data.get('memberUids', []) &&
        data.get('memberRoles', {}).get(request.auth.uid, 'REGISTAR') in ['CREATOR', 'OWNER', 'EDITOR']
      );
    }

    function isHouseholdMember(householdId) {
      return isAuthenticated() &&
        householdExists(householdId) &&
        isHouseholdMemberData(householdDoc(householdId).data);
    }

    function canManageHouseholdStructure(householdId) {
      return isAuthenticated() &&
        householdExists(householdId) &&
        canManageMembersAndCategoriesData(householdDoc(householdId).data);
    }

    function isValidUserCreate(userId) {
      return isOwner(userId) &&
        (!('uid' in incoming()) || incoming().uid == userId) &&
        (!('email' in incoming()) || incoming().email is string) &&
        (!('isPremium' in incoming()) || incoming().isPremium == false) &&
        !('birthDate' in incoming()) &&
        !('phoneNumber' in incoming()) &&
        !('occupation' in incoming()) &&
        !('city' in incoming()) &&
        !('acceptedLegalVersion' in incoming()) &&
        !('acceptedLegalAt' in incoming());
    }

    function isValidUserUpdate(userId) {
      return isOwner(userId) &&
        (!('uid' in incoming()) || incoming().uid == userId) &&
        (!('isPremium' in incoming()) || incoming().isPremium == existing().get('isPremium', false)) &&
        (!('birthDate' in incoming()) || incoming().birthDate == existing().get('birthDate', '')) &&
        (!('phoneNumber' in incoming()) || incoming().phoneNumber == existing().get('phoneNumber', '')) &&
        (!('occupation' in incoming()) || incoming().occupation == existing().get('occupation', '')) &&
        (!('city' in incoming()) || incoming().city == existing().get('city', '')) &&
        !('acceptedLegalVersion' in incoming()) &&
        !('acceptedLegalAt' in incoming());
    }

    function isValidPrivateProfileWrite() {
      return (!('birthDate' in incoming()) || (incoming().birthDate is string && incoming().birthDate.size() <= 40)) &&
        (!('phoneNumber' in incoming()) || (incoming().phoneNumber is string && incoming().phoneNumber.size() <= 40)) &&
        (!('occupation' in incoming()) || (incoming().occupation is string && incoming().occupation.size() <= 120)) &&
        (!('city' in incoming()) || (incoming().city is string && incoming().city.size() <= 120)) &&
        (!('acceptedLegalVersion' in incoming()) || (incoming().acceptedLegalVersion is string && incoming().acceptedLegalVersion.size() <= 40)) &&
        (!('acceptedLegalAt' in incoming()) || (incoming().acceptedLegalAt is int && incoming().acceptedLegalAt >= 0));
    }

    function isValidHouseholdCreate() {
      return isAuthenticated() &&
        incoming().ownerId == request.auth.uid &&
        incoming().name is string &&
        incoming().name.size() > 0 &&
        incoming().name.size() <= 120 &&
        incoming().memberUids is list &&
        request.auth.uid in incoming().memberUids &&
        (!('isPremium' in incoming()) || incoming().isPremium == false);
    }

    function isValidHouseholdCreatorUpdate() {
      return existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().name is string &&
        incoming().name.size() > 0 &&
        incoming().name.size() <= 120 &&
        incoming().memberUids is list &&
        (!('isPremium' in incoming()) || incoming().isPremium == existing().get('isPremium', false));
    }

    function isSelfUpdatingOwnDefaultPayer() {
      return isHouseholdMemberData(existing()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['memberDefaultPayers', 'updatedAt']) &&
        incoming().memberDefaultPayers is map &&
        incoming().memberDefaultPayers.diff(existing().get('memberDefaultPayers', {})).affectedKeys().hasOnly([request.auth.uid]) &&
        (
          !(request.auth.uid in incoming().memberDefaultPayers) ||
          (incoming().memberDefaultPayers[request.auth.uid] is string &&
            incoming().memberDefaultPayers[request.auth.uid].size() <= 200)
        );
    }

    function isSelfLeavingHousehold() {
      return isHouseholdMemberData(existing()) &&
        existing().ownerId != request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().name == existing().name &&
        incoming().get('isPremium', false) == existing().get('isPremium', false) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'memberUids', 'memberRoles', 'memberEmails', 'memberNames', 'memberDefaultPayers', 'updatedAt'
        ]) &&
        incoming().memberUids is list &&
        !(request.auth.uid in incoming().memberUids) &&
        existing().get('memberUids', []).hasAll(incoming().memberUids) &&
        incoming().memberUids.size() == existing().get('memberUids', []).size() - 1 &&
        incoming().get('memberRoles', {}).diff(existing().get('memberRoles', {})).affectedKeys().hasOnly([request.auth.uid]) &&
        !(request.auth.uid in incoming().get('memberRoles', {})) &&
        incoming().get('memberEmails', {}).diff(existing().get('memberEmails', {})).affectedKeys().hasOnly([request.auth.uid]) &&
        !(request.auth.uid in incoming().get('memberEmails', {})) &&
        incoming().get('memberNames', {}).diff(existing().get('memberNames', {})).affectedKeys().hasOnly([request.auth.uid]) &&
        !(request.auth.uid in incoming().get('memberNames', {})) &&
        incoming().get('memberDefaultPayers', {}).diff(existing().get('memberDefaultPayers', {})).affectedKeys().hasOnly([request.auth.uid]) &&
        !(request.auth.uid in incoming().get('memberDefaultPayers', {}));
    }

    function safeMap(data, key) {
      return (key in data && data[key] is map) ? data[key] : {};
    }

    function safeList(data, key) {
      return (key in data && data[key] is list) ? data[key] : [];
    }

    function isJoiningViaValidInvite(householdId) {
      let code = incoming().get('lastJoinedInviteCode', '');
      let invitePath = /databases/$(database)/documents/household_invites/$(code);
      let existingUids = safeList(existing(), 'memberUids');
      let existingRoles = safeMap(existing(), 'memberRoles');
      let incomingRoles = safeMap(incoming(), 'memberRoles');
      let existingEmails = safeMap(existing(), 'memberEmails');
      let incomingEmails = safeMap(incoming(), 'memberEmails');
      let existingNames = safeMap(existing(), 'memberNames');
      let incomingNames = safeMap(incoming(), 'memberNames');
      let existingDeleted = safeList(existing(), 'deletedForUsers');
      let incomingDeleted = safeList(incoming(), 'deletedForUsers');
      return !isHouseholdMemberData(existing()) &&
        code is string &&
        code.size() >= 10 &&
        code.size() <= 32 &&
        exists(invitePath) &&
        get(invitePath).data.householdId == householdId &&
        get(invitePath).data.isActive == true &&
        get(invitePath).data.get('expiresAt', 0) is int &&
        get(invitePath).data.get('expiresAt', 0) > request.time.toMillis() &&
        incoming().ownerId == existing().ownerId &&
        incoming().get('name', '') == existing().get('name', '') &&
        incoming().get('isPremium', false) == existing().get('isPremium', false) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'memberUids', 'memberRoles', 'memberEmails', 'memberNames', 'deletedForUsers', 'lastJoinedInviteCode', 'updatedAt'
        ]) &&
        incoming().memberUids is list &&
        request.auth.uid in incoming().memberUids &&
        incoming().memberUids.hasAll(existingUids) &&
        incoming().memberUids.size() == existingUids.size() + 1 &&
        incomingRoles.diff(existingRoles).affectedKeys().hasOnly([request.auth.uid]) &&
        incomingRoles[request.auth.uid] == get(invitePath).data.role &&
        incomingRoles[request.auth.uid] in ['EDITOR', 'REGISTAR'] &&
        incomingEmails.diff(existingEmails).affectedKeys().hasOnly([request.auth.uid]) &&
        (!(request.auth.uid in incomingEmails) || (incomingEmails[request.auth.uid] is string && incomingEmails[request.auth.uid].size() <= 160)) &&
        incomingNames.diff(existingNames).affectedKeys().hasOnly([request.auth.uid]) &&
        (!(request.auth.uid in incomingNames) || (incomingNames[request.auth.uid] is string && incomingNames[request.auth.uid].size() <= 120)) &&
        (!('deletedForUsers' in incoming().diff(existing()).affectedKeys()) || (
          !(request.auth.uid in incomingDeleted) &&
          existingDeleted.hasAll(incomingDeleted) &&
          incomingDeleted.size() == (request.auth.uid in existingDeleted ? existingDeleted.size() - 1 : existingDeleted.size())
        ));
    }

    function isValidExpenseOrIncomeWrite() {
      return incoming().title is string &&
        incoming().amount is number &&
        incoming().amount >= 0;
    }

    function isValidMemberWrite() {
      return ('name' in incoming() && incoming().name is string && incoming().name.size() > 0) ||
        (incoming().keys().hasOnly(['isDeleted']) && incoming().isDeleted is bool);
    }

    function isValidCategoryWrite() {
      return ('name' in incoming() && incoming().name is string && incoming().name.size() > 0) ||
        (incoming().keys().hasOnly(['isDeleted']) && incoming().isDeleted is bool);
    }

    // 1. User Profile & Private Personal User Database
    match /users/{userId} {
      // Authenticated users can read a single profile by UID or exact lookup (limit <= 1) for household sharing
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && request.query.limit <= 1;
      // Only the authenticated account owner can modify or delete their own profile
      allow create: if isValidUserCreate(userId);
      allow update: if isValidUserUpdate(userId);
      allow delete: if isOwner(userId);

      // Owner-only private profile details (birthDate, phoneNumber, occupation, city)
      match /private/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidPrivateProfileWrite();
        allow delete: if isOwner(userId);
      }

      // Personal user subcollections (expenses, incomes, categories, members, savings_goals, recurring_expenses)
      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId) && subcollection != 'private';
      }
    }

    // 2. Shared Household Database (3-Tier RBAC: CREATOR, EDITOR, REGISTAR)
    match /households/{householdId} {
      allow create: if isValidHouseholdCreate();
      allow read: if isAuthenticated() && (
        resource == null ||
        isHouseholdMemberData(existing())
      );
      allow update: if isAuthenticated() && (
        isValidHouseholdCreatorUpdate() ||
        isSelfUpdatingOwnDefaultPayer() ||
        isSelfLeavingHousehold() ||
        isJoiningViaValidInvite(householdId)
      );
      allow delete: if isAuthenticated() && existing().ownerId == request.auth.uid;

      // Members & Categories: CREATOR & EDITOR can create, edit, delete; REGISTAR is read-only
      match /members/{memberId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if canManageHouseholdStructure(householdId) && isValidMemberWrite();
        allow delete: if canManageHouseholdStructure(householdId);
      }

      match /categories/{categoryId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if canManageHouseholdStructure(householdId) && isValidCategoryWrite();
        allow delete: if canManageHouseholdStructure(householdId);
      }

      // Expenses & Incomes: CREATOR, EDITOR, and REGISTAR can read, create, update, delete
      match /expenses/{expenseId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId) && isValidExpenseOrIncomeWrite();
        allow delete: if isHouseholdMember(householdId);
      }

      match /incomes/{incomeId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId) && isValidExpenseOrIncomeWrite();
        allow delete: if isHouseholdMember(householdId);
      }

      // Savings Goals & Recurring Expenses: members can read, only CREATOR & EDITOR can write
      match /savings_goals/{goalId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update, delete: if canManageHouseholdStructure(householdId);
      }

      match /savingsGoals/{goalId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update, delete: if canManageHouseholdStructure(householdId);
      }

      match /recurring_expenses/{recurringId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update, delete: if canManageHouseholdStructure(householdId);
      }

      match /recurringExpenses/{recurringId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update, delete: if canManageHouseholdStructure(householdId);
      }

      // Shared Household Activity Log: append-only per actorUid for household members
      match /activity/{activityId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) &&
          incoming().actorUid == request.auth.uid &&
          incoming().actionType is string &&
          incoming().summaryEl is string;
        allow update: if false;
        allow delete: if isAuthenticated() &&
          householdExists(householdId) &&
          householdDoc(householdId).data.ownerId == request.auth.uid;
      }

      // Pre-aggregated monthly totals for FinOps-efficient historical summaries
      match /monthly_totals/{monthKey} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId) &&
          incoming().monthKey is string &&
          incoming().expenseTotal is number &&
          incoming().expenseTotal >= 0 &&
          incoming().incomeTotal is number &&
          incoming().incomeTotal >= 0;
        allow delete: if isAuthenticated() &&
          householdExists(householdId) &&
          householdDoc(householdId).data.ownerId == request.auth.uid;
      }
    }

    // 3. Household Invite Codes (Link / QR Join) - get-only by exact code (no list/enumeration)
    match /household_invites/{inviteCode} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated() &&
        inviteCode.size() >= 10 &&
        inviteCode.size() <= 32 &&
        incoming().code == inviteCode &&
        incoming().ownerId == request.auth.uid &&
        incoming().householdId is string &&
        householdExists(incoming().householdId) &&
        householdDoc(incoming().householdId).data.ownerId == request.auth.uid &&
        incoming().role in ['EDITOR', 'REGISTAR'] &&
        incoming().isActive == true &&
        incoming().expiresAt is int &&
        incoming().expiresAt > request.time.toMillis() &&
        incoming().expiresAt <= request.time.toMillis() + 608400000;
      allow update, delete: if isAuthenticated() && existing().ownerId == request.auth.uid;
    }
  }
}
