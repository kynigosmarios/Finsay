rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function householdDoc(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId));
    }

    function householdExists(householdId) {
      return exists(/databases/$(database)/documents/households/$(householdId));
    }

    function isHouseholdMemberData(data) {
      return data.ownerId == request.auth.uid ||
        request.auth.uid in data.get('memberUids', []);
    }

    function canManageMembersAndCategoriesData(data) {
      return data.ownerId == request.auth.uid || (
        request.auth.uid in data.get('memberUids', []) &&
        data.get('memberRoles', {}).get(request.auth.uid, 'REGISTAR') in ['CREATOR', 'OWNER', 'EDITOR']
      );
    }

    function isHouseholdMember(householdId) {
      return isAuthenticated() &&
        householdExists(householdId) &&
        isHouseholdMemberData(householdDoc(householdId).data);
    }

    function canManageHouseholdStructure(householdId) {
      return isAuthenticated() &&
        householdExists(householdId) &&
        canManageMembersAndCategoriesData(householdDoc(householdId).data);
    }

    function isValidUserCreate(userId) {
      return isOwner(userId) &&
        (!('uid' in incoming()) || incoming().uid == userId) &&
        (!('email' in incoming()) || incoming().email is string) &&
        (!('isPremium' in incoming()) || incoming().isPremium == false);
    }

    function isValidUserUpdate(userId) {
      return isOwner(userId) &&
        (!('uid' in incoming()) || incoming().uid == userId) &&
        (!('isPremium' in incoming()) || incoming().isPremium == existing().get('isPremium', false));
    }

    function isValidHouseholdCreate() {
      return isAuthenticated() &&
        incoming().ownerId == request.auth.uid &&
        incoming().name is string &&
        incoming().name.size() > 0 &&
        incoming().name.size() <= 120 &&
        incoming().memberUids is list &&
        request.auth.uid in incoming().memberUids &&
        (!('isPremium' in incoming()) || incoming().isPremium == false);
    }

    function isValidHouseholdCreatorUpdate() {
      return existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().name is string &&
        incoming().name.size() > 0 &&
        incoming().name.size() <= 120 &&
        incoming().memberUids is list &&
        (!('isPremium' in incoming()) || incoming().isPremium == existing().get('isPremium', false));
    }

    function isSelfUpdatingOwnDefaultPayer() {
      return isHouseholdMemberData(existing()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['memberDefaultPayers', 'updatedAt']) &&
        incoming().memberDefaultPayers is map &&
        incoming().memberDefaultPayers.diff(existing().get('memberDefaultPayers', {})).affectedKeys().hasOnly([request.auth.uid]) &&
        (
          !(request.auth.uid in incoming().memberDefaultPayers) ||
          (incoming().memberDefaultPayers[request.auth.uid] is string &&
            incoming().memberDefaultPayers[request.auth.uid].size() <= 200)
        );
    }

    function isValidExpenseOrIncomeWrite() {
      return incoming().title is string &&
        incoming().amount is number &&
        incoming().amount >= 0;
    }

    function isValidMemberWrite() {
      return ('name' in incoming() && incoming().name is string && incoming().name.size() > 0) ||
        (incoming().keys().hasOnly(['isDeleted']) && incoming().isDeleted is bool);
    }

    function isValidCategoryWrite() {
      return ('name' in incoming() && incoming().name is string && incoming().name.size() > 0) ||
        (incoming().keys().hasOnly(['isDeleted']) && incoming().isDeleted is bool);
    }

    // 1. User Profile & Private Personal User Database
    match /users/{userId} {
      // Authenticated users can read a single profile by UID or exact lookup (limit <= 1) for household sharing
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && request.query.limit <= 1;
      // Only the authenticated account owner can modify or delete their own profile
      allow create: if isValidUserCreate(userId);
      allow update: if isValidUserUpdate(userId);
      allow delete: if isOwner(userId);

      // Personal user subcollections (expenses, incomes, categories, members, savings_goals, recurring_expenses)
      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Shared Household Database (3-Tier RBAC: CREATOR, EDITOR, REGISTAR)
    match /households/{householdId} {
      allow create: if isValidHouseholdCreate();
      allow read: if isAuthenticated() && (
        resource == null ||
        isHouseholdMemberData(existing())
      );
      allow update: if isAuthenticated() && (
        isValidHouseholdCreatorUpdate() ||
        isSelfUpdatingOwnDefaultPayer()
      );
      allow delete: if isAuthenticated() && existing().ownerId == request.auth.uid;

      // Members & Categories: CREATOR & EDITOR can create, edit, delete; REGISTAR is read-only
      match /members/{memberId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if canManageHouseholdStructure(householdId) && isValidMemberWrite();
        allow delete: if canManageHouseholdStructure(householdId);
      }

      match /categories/{categoryId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if canManageHouseholdStructure(householdId) && isValidCategoryWrite();
        allow delete: if canManageHouseholdStructure(householdId);
      }

      // Expenses & Incomes: CREATOR, EDITOR, and REGISTAR can read, create, update, delete
      match /expenses/{expenseId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId) && isValidExpenseOrIncomeWrite();
        allow delete: if isHouseholdMember(householdId);
      }

      match /incomes/{incomeId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId) && isValidExpenseOrIncomeWrite();
        allow delete: if isHouseholdMember(householdId);
      }

      // Savings Goals & Recurring Expenses: members can read, only CREATOR & EDITOR can write
      match /savings_goals/{goalId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update, delete: if canManageHouseholdStructure(householdId);
      }

      match /savingsGoals/{goalId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update, delete: if canManageHouseholdStructure(householdId);
      }

      match /recurring_expenses/{recurringId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update, delete: if canManageHouseholdStructure(householdId);
      }

      match /recurringExpenses/{recurringId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update, delete: if canManageHouseholdStructure(householdId);
      }

      // Shared Household Activity Log: append-only per actorUid for household members
      match /activity/{activityId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) &&
          incoming().actorUid == request.auth.uid &&
          incoming().actionType is string &&
          incoming().summaryEl is string;
        allow update, delete: if false;
      }
    }
  }
}
